# DATAPULSE Environment Variables Example
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MySQL Database (Standard Laragon: root with empty password)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=datapulse_db

# Security
JWT_SECRET=replace_with_a_secure_jwt_secret_in_production

# AI Data Analyst (Optional: Grounded analytics works without API key using controlled semantic engine)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

